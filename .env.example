# Local synthetic demo only. Set 0 and configure unique passwords on any hosted installation.
BATON_DEMO=1
BATON_DB=data/baton.sqlite3
BATON_SECURE_COOKIE=0
# Optional Supabase Postgres connection for normalised, RLS-enforced persistence.
# Use a restricted runtime role, never the postgres admin or a Supabase service key.
DATABASE_URL=
# BATON_REVIEWER_PASSWORD=
# BATON_SUCCESSOR_PASSWORD=
# BATON_COORDINATOR_PASSWORD=
# BATON_LEAVER_PASSWORD=
# Backend-only model configuration. Never use a VITE_ prefix for a secret.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=15
# No text is sent to a second cloud provider unless explicitly selected here.
LLM_FALLBACK_PROVIDER=offline
# Optional Gemini fallback: set LLM_FALLBACK_PROVIDER=gemini and configure its key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
