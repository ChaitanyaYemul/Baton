{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["bom1"],
  "functions": {"api/index.py": {"maxDuration": 120}},
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index.py"},
    {"source": "/((?!api/).*)", "destination": "/index.html"}
  ]
}
